# Township One - Environment Variables Template
# Copy this file to .env for local development

# Application Configuration
APP_NAME=Township One
APP_ENV=development
DEBUG=true
PORT=8000
API_PREFIX=/api/v1
# Generate a secure secret key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Persistent P-256 PEM private key for offline guest credentials. Generate with:
# python -c "from cryptography.hazmat.primitives.asymmetric import ec; from cryptography.hazmat.primitives import serialization; k=ec.generate_private_key(ec.SECP256R1()); print(k.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()).decode())"
SIGNING_KEY=
# Alternatively set SIGNING_KEY_FILE to a protected PEM file path.
SIGNING_KEY_FILE=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Connection (PostgreSQL is standard per architecture; SQLite is an optional fast-test fallback)
DATABASE_URL=postgresql+psycopg://township:township_dev_password@localhost:5432/township_one
# Optional fast-test local fallback:
# DATABASE_URL=sqlite:///./township_one.db
TEST_DATABASE_URL=postgresql+psycopg://township:township_dev_password@localhost:5432/township_one_test
# Optional fast-test local fallback:
# TEST_DATABASE_URL=sqlite:///./township_one_test.db

# Authentication configuration
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRY_SECONDS=300
DEMO_OTP_CODE=123456
SMS_PROVIDER_API_KEY=

# Reference Snapshot Date
DEMO_AS_OF_DATE=2026-11-06T00:00:00Z

# Maintenance Billing Parameters
MAINTENANCE_RATE_PER_SQFT=6.50
DEFAULT_GRACE_PERIOD_DAYS=5
DEMO_LATE_FEE_PERCENTAGE_PA=18.00

# Private object storage. Local for development; the zero-card hosted demo uses authenticated Cloudinary assets.
STORAGE_BACKEND=local
STORAGE_DIR=./private_storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional alternative adapter; not used in the strict no-payment-method deployment.
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Long random token used only by the scheduled 90-day visitor-photo retention job.
RETENTION_JOB_TOKEN=

# AI provider is optional. Local complaint classifier works without an API key.
GROQ_API_KEY=
GROQ_MODEL_ID=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=5.0
