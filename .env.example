# Township One - Environment Variables Template
# Copy this file to .env for local development

# Application Configuration
APP_NAME=Township One
APP_ENV=development
DEBUG=true
PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=demo-secret-key-change-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Connection (PostgreSQL in production, SQLite supported locally)
DATABASE_URL=sqlite:///./township_one.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/township_one

# Authentication & Session
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRY_SECONDS=300
DEMO_OTP_CODE=123456

# AI / Provider Settings (Server-side only)
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile
ENABLE_LOCAL_AI_FALLBACK=true

# Retention / Scheduler
RETENTION_TRIGGER_HMAC_KEY=
RETENTION_BACKEND_URL=
RETENTION_BATCH_SIZE=50
RETENTION_LAST_SUCCESS_ALERT_MINUTES=30
